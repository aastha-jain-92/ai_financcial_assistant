# Core
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_finance
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
MODEL_NAME=openai/gpt-oss-120b
VISION_MODEL_NAME=meta-llama/llama-4-scout-17b-16e-instruct

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Encrypts OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; \
#              print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Google API tuning (optional)
GOOGLE_TIMEOUT_SECONDS=15
GOOGLE_MAX_RETRIES=3
GOOGLE_CACHE_TTL_SECONDS=60
GOOGLE_MAX_CONCURRENT_REQUESTS=5
GOOGLE_OAUTH_STATE_TTL_SECONDS=900
GOOGLE_TOKEN_REFRESH_LEEWAY_SECONDS=120

# Payload limits handed to the LLM (optional)
GMAIL_MAX_MESSAGES=10
GMAIL_MAX_BODY_CHARS=4000
CALENDAR_MAX_EVENTS=20
DRIVE_MAX_FILES=20
DRIVE_MAX_FILE_CHARS=6000
SHEETS_MAX_ROWS=100
TOOL_RESULT_MAX_CHARS=8000
MAX_TOOL_ITERATIONS=5

# Yahoo Finance
YAHOO_FINANCE_ENABLED=true
YAHOO_CACHE_TTL_SECONDS=60
YAHOO_TIMEOUT_SECONDS=10
YAHOO_MAX_NEWS=5
